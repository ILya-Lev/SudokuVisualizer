@page
@model IndexModel
@{
    ViewData["Title"] = "Sudoku Solver";
    var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
}

<style>
    #sudoku-grid {
        display: grid;
        grid-template-columns: repeat(9, 40px);
        grid-template-rows: repeat(9, 40px);
        width: max-content;
        border-top: 3px solid black;
        border-left: 3px solid black;
        background-color: #fff;
    }

    .sudoku-cell {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: bold;
        border-right: 1px solid #ccc;
        border-bottom: 1px solid #ccc;
        box-sizing: border-box;
    }

        .sudoku-cell.thick-right {
            border-right: 3px solid black;
        }

        .sudoku-cell.thick-bottom {
            border-bottom: 3px solid black;
        }

        .sudoku-cell.highlight {
            color: #0066cc;
        }

    .nav-btn {
        font-size: 1.5rem;
        cursor: pointer;
        background: none;
        border: 1px solid #ccc;
        padding: 0 10px;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 30px;
    }

        .nav-btn:hover {
            background-color: #f0f0f0;
        }
</style>

<div style="margin-bottom: 2rem;">
    <form method="post" enctype="multipart/form-data">
        <input type="file" name="puzzleFile" accept=".txt" required />
        <button type="submit">Load and Solve</button>
    </form>
</div>

@if (Model.InitialBoard != null && Model.InitialBoard.Length > 0)
{
    <div style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 1rem;">
        <button id="prevBtn" class="nav-btn" title="Previous Step">&lt;</button>
        <input type="range" id="stepSlider" min="0" max="@Model.Steps.Count" value="0" style="width: 300px;" />
        <button id="nextBtn" class="nav-btn" title="Next Step">&gt;</button>
    </div>
    <div style="margin-bottom: 0.5rem; display: flex; align-items: center; gap: 1rem;">
        <div style="width: 180px; text-align: center; color: green; font-family: monospace; font-size: 1.3rem;">
            @Model.LoadedFileName
        </div>
        <span id="stepLabel" style="font-family: monospace; font-size: 1.2rem;">Step: 0 / @Model.Steps.Count</span>
    </div>


    <div id="sudoku-grid">
    </div>

    <script>
        const initialBoard = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.InitialBoard, jsonOptions));
        const steps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Steps, jsonOptions));

        const grid = document.getElementById('sudoku-grid');
        const slider = document.getElementById('stepSlider');
        const label = document.getElementById('stepLabel');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');

        function renderBoard(stepIndexValue) {
            const stepIndex = parseInt(stepIndexValue, 10);
            label.innerText = `Step: ${stepIndex} / ${steps.length}`;
            slider.value = stepIndex;
            grid.innerHTML = '';

            let currentBoard = initialBoard.map(row => [...row]);

            for (let i = 0; i < stepIndex; i++) {
                const step = steps[i];
                if (!step) continue;

                const r = step.r !== undefined ? step.r : step.R;
                const c = step.c !== undefined ? step.c : step.C;
                const digit = step.digit !== undefined ? step.digit : step.Digit;

                if (r >= 0 && r < 9 && c >= 0 && c < 9) {
                    currentBoard[r][c] = digit;
                }
            }

            for (let r = 0; r < 9; r++) {
                for (let c = 0; c < 9; c++) {
                    const cell = document.createElement('div');
                    cell.className = 'sudoku-cell';

                    if (c % 3 === 2) cell.classList.add('thick-right');
                    if (r % 3 === 2) cell.classList.add('thick-bottom');

                    const val = currentBoard[r][c];
                    if (val > 0) {
                        cell.innerText = val;
                        if (initialBoard[r][c] === 0) {
                            cell.classList.add('highlight');
                        }
                    }

                    grid.appendChild(cell);
                }
            }
        }

        function changeStep(delta) {
            let currentStep = parseInt(slider.value, 10);
            let newStep = currentStep + delta;

            if (newStep >= 0 && newStep <= steps.length) {
                renderBoard(newStep);
            }
        }

        slider.addEventListener('input', (e) => renderBoard(e.target.value));
        prevBtn.addEventListener('click', () => changeStep(-1));
        nextBtn.addEventListener('click', () => changeStep(1));

        renderBoard(0);
    </script>
}